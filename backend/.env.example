# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password
DB_NAME=simplechat

# Server
PORT=5001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
# Hạn token khi bật "Ghi nhớ đăng nhập"
JWT_REMEMBER_EXPIRES_IN=30d

# Khóa AES-256 mã hóa secret đăng nhập 2 bước (32 byte base64). Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đổi khóa sau khi đã có người bật MFA thì họ sẽ không đăng nhập được.
MFA_ENC_KEY=change_me

# Admin defaults
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
ADMIN_EMAIL=admin@example.com

# CORS (production: https://simplechat.io.vn)
CORS_ORIGIN=http://localhost:5173

# Email (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
